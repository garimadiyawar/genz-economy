# Gen Z Economy Report — API Keys
# All free to obtain:

# FRED (St. Louis Federal Reserve) — Get at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# US Census Bureau — Get at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your_census_key_here

# College Scorecard — Get at: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=your_scorecard_key_here

# NewsAPI (free tier: 100 req/day) — Get at: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Project settings
DATA_DIR=./data
LOG_LEVEL=INFO
